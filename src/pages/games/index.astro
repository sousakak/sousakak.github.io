---
import Layout from "../../layouts/Layout.astro";
import AppScrollableSections from "../../components/AppScrollableSections.vue";
import AppTitlePanel from "../../components/AppTitlePanel.vue";
import AppCardPanel, { type CardFlowItem } from "../../components/AppCardPanel.vue";

import { getTranslator } from "../../i18n";

const locale = Astro.currentLocale ?? "en";
const t = getTranslator( locale );

const games: CardFlowItem[] = [
    { id: 1, title: "ナンプレ", icon: "/icons/game-a.svg", description: "よくあるナンプレ（数独）ゲームです。", href: "/sudoku" },
    { id: 2, title: "ぼくのかんがえたさいきょうのひっさつわざ", icon: "/icons/game-b.svg", description: "さいきょーの必殺技をつくりだそー。" },
    { id: 3, title: "カラーソート", icon: "/icons/game-c.svg", description: "試験管の中の色水を入れ替えて同じ色で統一する、あれ。" },
    { id: 4, title: "ビルディングパズル", icon: "/icons/game-d.png", description: "各方向からビルが何本見えるかをヒントに、盤面を埋めていくパズル。" },
];

const handleSearch = ( query: string ): void => {
    // 検索アルゴリズム
};
---

<Layout>
    <AppScrollableSections client:load>
        <AppTitlePanel title={t('games-title')} >
            <p>{t('games-subtitle')}</p>
        </AppTitlePanel>
        <AppCardPanel
            items={games}
            rows={1}
            @search={handleSearch}
            client:visible
        />
    </AppScrollableSections>
</Layout>